# Build artifacts
/bin/
*.test
*.out

# Output of the rotation-testbed CI job (TESTBED_OUT); untracked, it would
# mark every receipt's working tree dirty.
/testbed-out/

# Go
/.gocache/
/.gomodcache/

# Tool-specific instruction files — not part of this repository.
# Human/agent norms for this repo live in CONTRIBUTING.md and SECURITY.md.
CLAUDE.md
CLAUDE-*.md
.claude/
dev-docs/

# Rotation testbed in CI: out directories and the pinned Mesh checkout live in
# the build directory; the receipt's working_tree_dirty must not count them.
/testbed-mesh-out/
/.testbed-mesh-src/

# Local tool logs
/logs/

# Local editor/OS cruft
.DS_Store
.idea/
.vscode/
*.swp

# Python bytecode
__pycache__/
