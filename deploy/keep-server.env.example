# keep-server configuration: variable NAMES only. Copy to a root-owned,
# mode 0600 file outside the repository and fill the values there. Never
# commit a filled copy. Secret-bearing settings are file paths, not values.

# PostgreSQL 17 connection URL (required). Carries the password: keep it in
# the env file only.
KEEP_DATABASE_URL=

# Path to the file with the sealer root key: 32 raw bytes or their base64
# (required to serve). Keep it outside the database, outside backups of it.
KEEP_ROOT_KEY_FILE=
# Persistent identifier stored next to wrapped keys (default local-v1).
KEEP_ROOT_KEY_ID=

# Public https URL of this server, as clients reach it behind the proxy.
KEEP_PUBLIC_URL=

# Server certificate for the runner TLS listener (both required).
KEEP_SERVER_TLS_CERT_FILE=
KEEP_SERVER_TLS_KEY_FILE=

# Listeners (defaults :8080 for /healthz and /readyz, :8443 for runners).
KEEP_HTTP_ADDR=
KEEP_RUNNER_ADDR=

# Reverse proxies whose X-Forwarded-For names the client (comma-separated
# CIDR). Behind a local proxy set 127.0.0.1/32: without it every Mesh caller
# shares the proxy's one pre-authentication budget.
KEEP_TRUSTED_PROXIES=127.0.0.1/32
